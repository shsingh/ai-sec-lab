# --- python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
_site/
.quarto/
.ipynb_checkpoints/
notebooks/_build/

# --- nix / os ---
result
result-*
.reproducible-gate
.direnv/
.DS_Store

# --- models & runtime state (never commit weights) ---
models/
*.gguf
*.safetensors
laya_home/

# --- terraform ---
# .terraform.lock.hcl is COMMITTED: it pins provider hashes (the tofu
# contract, verified by `nix run .#tofu -- init -lockfile` in CI).
terraform/.terraform/
terraform/terraform.tfstate*

# --- local toolchain records / scratch ---
.toolchain-path
nohup.out

/.quarto/
**/*.quarto_ipynb
